# be(Spring) 베이스 URL.
# 로컬 dev는 Vite 프록시(/api → localhost:8090)를 타므로 /api 로 두는 걸 권장.
# (절대 URL로 두면 크로스오리진이 되어 CSRF 쿠키를 JS가 못 읽음 → POST 403)
VITE_BE_BASE=/api

# 추천 nlp 게이트웨이. be nlp 게이트웨이 완성되면 be(/api)로 전환.
VITE_API_BASE=http://localhost:8000/api

# 카카오맵 JS SDK 앱키 (features/map 실지도)
VITE_KAKAO_MAP_KEY=
